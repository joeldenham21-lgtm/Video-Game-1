[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="creatures"
3d_physics/layer_4="items"
3d_physics/layer_5="interact"
3d_physics/layer_6="water"
3d_physics/layer_7="building"
3d_physics/layer_8="triggers"
3d_physics/layer_9="projectiles"
3d_physics/layer_10="vegetation"

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
anti_aliasing/quality/msaa_3d.mobile=1

